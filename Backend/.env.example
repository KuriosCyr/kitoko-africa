# Copier ce fichier vers Backend/.env puis adapter les valeurs.
# Ne jamais versionner le fichier .env (il est ignoré par git).

# development ou production
NODE_ENV=development
PORT=3000

# Compte administrateur créé au premier démarrage s'il n'existe pas.
# En production : mot de passe de 12 caractères minimum, obligatoire.
ADMIN_EMAIL=admin@kitokoafrika.org
ADMIN_PASSWORD=

# Durée de validité d'une connexion, en jours.
SESSION_DAYS=30

# Origines autorisées à appeler l'API depuis un autre domaine, séparées par
# des virgules (ex. application mobile : capacitor://localhost,https://localhost).
# Vide : tout est accepté en développement, rien en production.
CORS_ORIGINS=

# Derrière un reverse proxy (Nginx, Caddy…), mettre 1.
TRUST_PROXY=

# Emplacements des données (par défaut Backend/data et Backend/uploads).
# DB_PATH=./data/kitoko-afrika.db
# UPLOAD_DIR=./uploads
